# PostgreSQL (Neon via Vercel sets this automatically). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Admin login: random string, 32+ characters (e.g. `openssl rand -base64 48`).
AUTH_SECRET=

# First super admin, created by `npm run db:setup` (or the build) when no admins exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: timezone trips are planned in (default Asia/Karachi).
NEXT_PUBLIC_TIMEZONE=Asia/Karachi

# Optional: the site's public address, used in share links and link previews.
# Set it once the domain works (e.g. https://hamsafar.website). Without it, Vercel's production domain is used.
SITE_URL=
# Optional: the domain shown in footers and link previews (default hamsafar.website).
NEXT_PUBLIC_SITE_DOMAIN=

# Optional platform branding (default "Hamsafar"). Each organisation's own name is set in the super admin.
NEXT_PUBLIC_PLATFORM_NAME=Hamsafar
NEXT_PUBLIC_PLATFORM_TAGLINE=
# WhatsApp number for the "Contact" buttons, with country code (e.g. 923001234567).
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Optional: WhatsApp phone verification (Meta WhatsApp Business Cloud API). Without these, numbers aren't checked.
# Sending codes (an approved "Authentication" template whose body has {{1}} and a "Copy code" button):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANG=en
# Receiving messages (free: people send us the code). Webhook URL: https://<your domain>/api/whatsapp/webhook
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Set to "off" to stop checking numbers without removing the settings above.
PHONE_VERIFICATION=

# Optional: key for encrypting ID photos (default: derived from AUTH_SECRET). Set it once and never change it,
# or photos already stored can't be opened.
ID_ENCRYPTION_KEY=
# Optional WhatsApp alerts (needs the WhatsApp settings above). Admin number with 92, and approved "Utility" templates:
# a new ID to check ({{1}} = name) and "your ID is approved" to the person ({{1}} = first name).
ADMIN_WHATSAPP=
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_APPROVED_TEMPLATE=

# Optional: Google sign-in for riders and drivers. When both are set, offering a ride and booking a seat
# need a Google account (searching and viewing rides stay open). Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID (Web application), redirect URI https://<your domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

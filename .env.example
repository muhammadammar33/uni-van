# PostgreSQL (Neon via Vercel sets this automatically). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Admin login: random string, 32+ characters (e.g. `openssl rand -base64 48`).
AUTH_SECRET=

# First admin account, created by `npm run db:setup` (or the build) when no admins exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: timezone trips are planned in (default Asia/Karachi).
NEXT_PUBLIC_TIMEZONE=Asia/Karachi

# Optional: public address used in share links (defaults to the address the admin is using).
SITE_URL=

# Optional branding for the home page and link previews.
NEXT_PUBLIC_BRAND_NAME=Uni Van
NEXT_PUBLIC_BRAND_TAGLINE=
# WhatsApp number for the "Contact" buttons, with country code (e.g. 923001234567).
NEXT_PUBLIC_CONTACT_WHATSAPP=
